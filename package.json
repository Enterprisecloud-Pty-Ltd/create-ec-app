{
	"name": "create-ec-app",
	"version": "0.0.13",
	"description": "Unified CLI tool to create different types of EC applications: Webresource, Portal, Power Pages, Power Apps Code Apps",
	"bin": {
		"create-ec-app": "./dist/index.js"
	},
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsc -p tsconfig.json",
		"check:css-scope": "node scripts/check-generated-css-scope.mjs",
		"test": "vitest run --coverage",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"smoke:scaffold": "node scripts/smoke-scaffold.mjs",
		"build:generated": "node scripts/build-generated.mjs",
		"refresh:shadcn-template": "tsx scripts/refresh-shadcn-template.ts",
		"release": "semantic-release",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"react",
		"vite",
		"kendo",
		"tailwind",
		"cli",
		"powerpages",
		"code-apps",
		"power-apps-code-apps",
		"portal",
		"webresource",
		"dynamics",
		"ec"
	],
	"engines": {
		"node": ">=22.14.0"
	},
	"files": [
		"dist/**/*",
		"bin/**/*",
		"scripts/**/*",
		"templates/**/*"
	],
	"author": "Schalk Conradie",
	"type": "module",
	"dependencies": {
		"@clack/prompts": "^1.6.0",
		"fs-extra": "^11.3.5",
		"postcss": "^8.5.16"
	},
	"devDependencies": {
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/github": "^12.0.8",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^22.20.0",
		"@vitest/coverage-v8": "^4.1.9",
		"semantic-release": "^25.0.5",
		"ts-node": "^10.9.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Enterprisecloud-Pty-Ltd/create-ec-app.git"
	},
	"bugs": {
		"url": "https://github.com/Enterprisecloud-Pty-Ltd/create-ec-app/issues"
	},
	"homepage": "https://github.com/Enterprisecloud-Pty-Ltd/create-ec-app#readme"
}
