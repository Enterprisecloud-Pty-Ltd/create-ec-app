{
	"name": "create-ec-app",
	"version": "0.0.13",
	"description": "Unified CLI tool to create different types of EC applications: Webresource, Portal, Power Pages, Power Apps Code Apps",
	"bin": {
		"create-ec-app": "./dist/index.js"
	},
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsc -p tsconfig.json",
		"check:css-scope": "node scripts/check-generated-css-scope.mjs",
		"test": "node bin/index.js test-app",
		"release": "semantic-release",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"react",
		"vite",
		"kendo",
		"tailwind",
		"cli",
		"powerpages",
		"code-apps",
		"power-apps-code-apps",
		"portal",
		"webresource",
		"dynamics",
		"ec"
	],
	"engines": {
		"node": ">=22.14.0"
	},
	"files": [
		"dist/**/*",
		"bin/**/*",
		"scripts/**/*",
		"templates/**/*"
	],
	"author": "Schalk Conradie",
	"type": "module",
	"dependencies": {
		"@clack/prompts": "^0.11.0",
		"fs-extra": "^11.3.2",
		"postcss": "^8.5.15"
	},
	"devDependencies": {
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/github": "^12.0.6",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^24.10.1",
		"semantic-release": "^25.0.3",
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Enterprisecloud-Pty-Ltd/create-ec-app.git"
	},
	"bugs": {
		"url": "https://github.com/Enterprisecloud-Pty-Ltd/create-ec-app/issues"
	},
	"homepage": "https://github.com/Enterprisecloud-Pty-Ltd/create-ec-app#readme"
}
